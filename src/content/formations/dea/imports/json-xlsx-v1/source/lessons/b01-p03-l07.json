  "lesson_title": "Le système cardiovasculaire",
  "knowledge": [
    {
      "id": "K161",
      "title": "Définition",
      "content": "Le système cardiovasculaire assure la circulation du sang afin d'apporter l'oxygène et les nutriments aux tissus et d'éliminer les déchets métaboliques."
    },
    {
      "id": "K162",
      "title": "Le cœur",
      "content": "Le cœur est un muscle creux constitué de quatre cavités : deux oreillettes et deux ventricules."
    },
    {
      "id": "K163",
      "title": "Les artères",
      "content": "Les artères transportent le sang du cœur vers les organes."
    },
    {
      "id": "K164",
      "title": "Les veines",
      "content": "Les veines ramènent le sang des organes vers le cœur."
    },
    {
      "id": "K165",
      "title": "Les capillaires",
      "content": "Les capillaires permettent les échanges entre le sang et les tissus."
    },
    {
      "id": "K166",
      "title": "Double circulation",
      "content": "La circulation sanguine comprend une circulation pulmonaire et une circulation systémique."
    }
  ],
