  "lesson_title": "Le système digestif",
  "knowledge": [
    {
      "id": "K173",
      "title": "Définition",
      "content": "Le système digestif transforme les aliments en nutriments utilisables par l'organisme."
    },
    {
      "id": "K174",
      "title": "Trajet des aliments",
      "content": "Les aliments passent successivement par la bouche, le pharynx, l'œsophage, l'estomac, l'intestin grêle, le côlon, le rectum puis l'anus."
    },
    {
      "id": "K175",
      "title": "Estomac",
      "content": "L'estomac mélange les aliments avec les sucs gastriques afin de débuter leur digestion."
    },
    {
      "id": "K176",
      "title": "Intestin grêle",
      "content": "La majorité de l'absorption des nutriments se réalise dans l'intestin grêle."
    },
    {
      "id": "K177",
      "title": "Foie",
      "content": "Le foie produit la bile, participe au métabolisme et au stockage de nombreuses substances."
    },
    {
      "id": "K178",
      "title": "Pancréas",
      "content": "Le pancréas sécrète des enzymes digestives et des hormones comme l'insuline."
    }
  ],
